# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Xcode archive/build phases do not reliably inherit the same PATH as an
# interactive shell, so prefer the project's required Node 20 runtime when it
# is available and only fall back to the ambient `node`.
if [ -x "/opt/homebrew/opt/node@20/bin/node" ]; then
  export NODE_BINARY="/opt/homebrew/opt/node@20/bin/node"
elif [ -x "/usr/local/opt/node@20/bin/node" ]; then
  export NODE_BINARY="/usr/local/opt/node@20/bin/node"
elif [ -n "${NVM_DIR:-}" ] && [ -s "${NVM_DIR}/nvm.sh" ]; then
  . "${NVM_DIR}/nvm.sh"
  nvm use --silent >/dev/null 2>&1 || true
  export NODE_BINARY="$(command -v node)"
else
  export NODE_BINARY="$(command -v node)"
fi
